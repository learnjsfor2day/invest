# Copy to .env and fill in. All keys are OPTIONAL — the pipeline runs without them
# (just with reduced coverage). Load via: `set -a; source .env; set +a` before running.

# Financial Modeling Prep — fundamentals + transcripts + earnings calendar
# https://site.financialmodelingprep.com/  (Starter ~$22/mo covers transcripts)
FMP_API_KEY=

# Anthropic — for LLM extraction of quotes/signals from transcripts
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Lark (飞书) webhook — push notifications. Leave blank to print to stdout only.
# Bot setup: 群设置 → 群机器人 → 添加 → 自定义机器人 → 复制 webhook
LARK_WEBHOOK_URL=

# SEC EDGAR requires a User-Agent identifying you (free, no key)
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=invest-monitor your-email@example.com
